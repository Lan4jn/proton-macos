diff --git a/tests/test-preempt-lifecycle-host.c b/tests/test-preempt-lifecycle-host.c
new file mode 100644
index 0000000..54075fe
--- /dev/null
+++ b/tests/test-preempt-lifecycle-host.c
@@ -0,0 +1,143 @@
+/*
+ * Unit test: proc_preempt_stop production lifecycle and happens-before join
+ *
+ * Copyright 2026 elfuse contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Directly exercises the real production proc_preempt_init() and
+ * proc_preempt_stop() implementations in src/syscall/proc.c.
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "syscall/proc.h"
+#include "core/guest.h"
+
+static int fails;
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (!(cond)) {                                                       \
+            printf("  FAIL %s:%d: %s\n", __func__, __LINE__, #cond);         \
+            fails++;                                                         \
+        }                                                                    \
+    } while (0)
+
+/* Test 1: Real production start and clean stop */
+static void test_real_start_stop(void)
+{
+    printf("  [TEST 1] real production proc_preempt_init and proc_preempt_stop...\n");
+    int rc = proc_preempt_init();
+    CHECK(rc == 0);
+
+    /* Real production stop must return 0 */
+    int s = proc_preempt_stop();
+    CHECK(s == 0);
+}
+
+/* Test 2: Real production stop idempotency */
+static void test_real_stop_idempotent(void)
+{
+    printf("  [TEST 2] real production stop idempotency...\n");
+    /* Calling stop again on already stopped thread must return 0 without error */
+    int s1 = proc_preempt_stop();
+    CHECK(s1 == 0);
+    int s2 = proc_preempt_stop();
+    CHECK(s2 == 0);
+}
+
+/* Test 3: Multiple real production init-stop cycles */
+static void test_real_reinit_cycles(void)
+{
+    printf("  [TEST 3] 5 real production init-stop cycles...\n");
+    for (int i = 0; i < 5; i++) {
+        int rc = proc_preempt_init();
+        CHECK(rc == 0);
+        int s = proc_preempt_stop();
+        CHECK(s == 0);
+    }
+}
+
+/* Test 4: Signal delivered to process then stopped */
+static void test_real_signal_then_stop(void)
+{
+    printf("  [TEST 4] signal delivery to real preemption thread then stop...\n");
+    int rc = proc_preempt_init();
+    CHECK(rc == 0);
+
+    /* Send SIGALRM to self; the real preemption thread catches it via sigwait */
+    kill(getpid(), SIGALRM);
+    usleep(10000); /* 10ms for thread to process */
+
+    int s = proc_preempt_stop();
+    CHECK(s == 0);
+}
+
+/* Test 5: Fork child state reset through real pthread_atfork */
+static void test_real_fork_child_state(void)
+{
+    printf("  [TEST 5] fork child state reset with real pthread_atfork...\n");
+    int rc = proc_preempt_init();
+    CHECK(rc == 0);
+
+    pid_t pid = fork();
+    CHECK(pid >= 0);
+    if (pid == 0) {
+        /* In child: real pthread_atfork must have reset g_preempt_started to false */
+        /* Calling stop in child must be safe no-op returning 0 */
+        int s_child = proc_preempt_stop();
+        if (s_child != 0) {
+            _exit(1);
+        }
+        /* Re-init in child must start fresh thread */
+        int init_child = proc_preempt_init();
+        if (init_child != 0) {
+            _exit(2);
+        }
+        int s_child2 = proc_preempt_stop();
+        if (s_child2 != 0) {
+            _exit(3);
+        }
+        _exit(0);
+    }
+
+    int status = 0;
+    waitpid(pid, &status, 0);
+    CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+
+    int s = proc_preempt_stop();
+    CHECK(s == 0);
+}
+
+/* Test 6: Verify guest_teardown_failed flag behavior */
+static void test_teardown_failed_flag(void)
+{
+    printf("  [TEST 6] guest_teardown_failed flag and recovery...\n");
+    guest_teardown_clear_failure();
+    CHECK(!guest_teardown_failed());
+}
+
+int main(void)
+{
+    printf("test-preempt-lifecycle-host: testing REAL production proc_preempt functions\n");
+    test_real_start_stop();
+    test_real_stop_idempotent();
+    test_real_reinit_cycles();
+    test_real_signal_then_stop();
+    test_real_fork_child_state();
+    test_teardown_failed_flag();
+
+    if (fails == 0) {
+        printf("  ALL REAL PRODUCTION PREEMPT LIFECYCLE CHECKS PASSED\n");
+        return 0;
+    }
+    return 1;
+}
diff --git a/tests/test_futex_abi_suite.c b/tests/test_futex_abi_suite.c
new file mode 100644
index 0000000..4e1c0f3
--- /dev/null
+++ b/tests/test_futex_abi_suite.c
@@ -0,0 +1,300 @@
+typedef unsigned int uint32_t;
+typedef unsigned long uint64_t;
+
+#define FUTEX_WAIT 0
+#define FUTEX_WAKE 1
+#define FUTEX_WAIT_BITSET 9
+#define FUTEX_WAKE_BITSET 10
+#define FUTEX_PRIVATE_FLAG 128
+#define FUTEX_WAIT_PRIVATE (FUTEX_WAIT | FUTEX_PRIVATE_FLAG)
+#define FUTEX_WAKE_PRIVATE (FUTEX_WAKE | FUTEX_PRIVATE_FLAG)
+
+#define WNOHANG 1
+
+static inline long sc(long n, long a, long b, long c, long d, long e, long f) {
+    register long x8 __asm__("x8") = n;
+    register long x0 __asm__("x0") = a;
+    register long x1 __asm__("x1") = b;
+    register long x2 __asm__("x2") = c;
+    register long x3 __asm__("x3") = d;
+    register long x4 __asm__("x4") = e;
+    register long x5 __asm__("x5") = f;
+    __asm__ volatile("svc #0" : "+r"(x0) : "r"(x8), "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5) : "memory");
+    return x0;
+}
+
+static inline void print_str(const char *s) {
+    long len = 0;
+    while (s[len]) len++;
+    sc(64, 1, (long)s, len, 0, 0, 0);
+}
+
+struct ts {
+    long tv_sec;
+    long tv_nsec;
+};
+
+void _start(void) {
+    print_str("--- FUTEX ABI TEST SUITE ---\n");
+
+    // Allocate shared page
+    volatile uint32_t *p = (void *)sc(222, 0, 16384, 3, 0x21, -1, 0); // mmap MAP_SHARED|MAP_ANONYMOUS
+    if ((long)p < 0 && (long)p > -4096) {
+        print_str("FAIL: mmap shared failed\n");
+        sc(93, 1, 0, 0, 0, 0, 0);
+    }
+    *p = 0;
+
+    // 1. Zero wake on zero waiters -> 0
+    long r1 = sc(98, (long)p, FUTEX_WAKE, 0, 0, 0, 0);
+    if (r1 != 0) {
+        print_str("FAIL: zero wake returned non-zero\n");
+        sc(93, 10, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 1 (zero wake -> 0)\n");
+
+    // 2. Wake with zero waiters -> 0
+    long r2 = sc(98, (long)p, FUTEX_WAKE, 1, 0, 0, 0);
+    if (r2 != 0) {
+        print_str("FAIL: wake 0 waiters returned non-zero\n");
+        sc(93, 11, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 2 (wake 0 waiters -> 0)\n");
+
+    // 3. Initial mismatch returns EAGAIN (-11)
+    *p = 42;
+    long r3 = sc(98, (long)p, FUTEX_WAIT, 999, 0, 0, 0); // expected 999, actual is 42
+    if (r3 != -11) {
+        print_str("FAIL: value mismatch did not return -EAGAIN\n");
+        sc(93, 12, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 3 (mismatch -> -EAGAIN)\n");
+
+    // 4. Timeout returns ETIMEDOUT (-110)
+    *p = 100;
+    struct ts short_to = {0, 30000000}; // 30ms
+    long r4 = sc(98, (long)p, FUTEX_WAIT, 100, (long)&short_to, 0, 0);
+    if (r4 != -110) {
+        print_str("FAIL: timeout did not return -ETIMEDOUT\n");
+        sc(93, 13, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 4 (timeout -> -ETIMEDOUT)\n");
+
+    // 5. Cross-process fork wait + wake
+    *p = 0;
+    long child = sc(220, 17, 0, 0, 0, 0, 0); // clone(SIGCHLD)
+    if (child < 0) {
+        print_str("FAIL: clone failed\n");
+        sc(93, 14, 0, 0, 0, 0, 0);
+    }
+    if (child == 0) {
+        // Child: delay 30ms, set *p = 1, call FUTEX_WAKE
+        struct ts d = {0, 30000000};
+        sc(101, (long)&d, 0, 0, 0, 0, 0); // nanosleep
+        *p = 1;
+        __asm__ volatile("dmb ish" ::: "memory");
+        long w = sc(98, (long)p, FUTEX_WAKE, 1, 0, 0, 0);
+        sc(93, w < 0 ? 99 : 0, 0, 0, 0, 0, 0); // exit(0)
+    }
+
+    // Parent waits with 1s limit
+    struct ts limit = {1, 0};
+    long w_res = sc(98, (long)p, FUTEX_WAIT, 0, (long)&limit, 0, 0);
+    int c_status = -1;
+    sc(260, child, (long)&c_status, 0, 0, 0, 0); // wait4
+
+    if (w_res != 0 && w_res != -11) {
+        print_str("FAIL: cross-process wait returned failure\n");
+        sc(93, 15, 0, 0, 0, 0, 0);
+    }
+    if (*p != 1) {
+        print_str("FAIL: *p was not 1 after wake\n");
+        sc(93, 16, 0, 0, 0, 0, 0);
+    }
+    if ((c_status >> 8) != 0) {
+        print_str("FAIL: child exited with error\n");
+        sc(93, 17, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 5 (cross-process fork wait+wake)\n");
+
+    // 6. Two waiters: wake 1 leaves exactly 1 blocked, second wake leaves 0
+    volatile uint32_t *p_two = (void *)sc(222, 0, 16384, 3, 0x21, -1, 0);
+    *p_two = 0;
+    long c1 = sc(220, 17, 0, 0, 0, 0, 0);
+    if (c1 == 0) {
+        // Child 1 waits on p_two
+        struct ts t = {2, 0};
+        sc(98, (long)p_two, FUTEX_WAIT, 0, (long)&t, 0, 0);
+        sc(93, 21, 0, 0, 0, 0, 0);
+    }
+    long c2 = sc(220, 17, 0, 0, 0, 0, 0);
+    if (c2 == 0) {
+        // Child 2 waits on p_two
+        struct ts t = {2, 0};
+        sc(98, (long)p_two, FUTEX_WAIT, 0, (long)&t, 0, 0);
+        sc(93, 22, 0, 0, 0, 0, 0);
+    }
+
+    // Give children time to park
+    struct ts park_d = {0, 50000000}; // 50ms
+    sc(101, (long)&park_d, 0, 0, 0, 0, 0);
+
+    // Wake 1 waiter
+    long woke_1 = sc(98, (long)p_two, FUTEX_WAKE, 1, 0, 0, 0);
+    if (woke_1 != 1) {
+        print_str("FAIL: wake 1 did not return 1\n");
+        sc(93, 18, 0, 0, 0, 0, 0);
+    }
+
+    // Wait 30ms to let the woken child exit
+    struct ts settle_d = {0, 30000000};
+    sc(101, (long)&settle_d, 0, 0, 0, 0, 0);
+
+    // Check with wait4(WNOHANG): exactly one child must have exited, the other still blocked
+    int st1 = -1, st2 = -1;
+    long r_c1 = sc(260, c1, (long)&st1, WNOHANG, 0, 0, 0);
+    long r_c2 = sc(260, c2, (long)&st2, WNOHANG, 0, 0, 0);
+
+    int dead_count = (r_c1 > 0 ? 1 : 0) + (r_c2 > 0 ? 1 : 0);
+    if (dead_count != 1) {
+        print_str("FAIL: wake 1 did not leave exactly 1 child running\n");
+        sc(93, 19, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 6a (wake 1 wakes exactly 1, leaves 1 blocked)\n");
+
+    // Now wake the remaining waiter
+    long woke_2 = sc(98, (long)p_two, FUTEX_WAKE, 1, 0, 0, 0);
+    if (woke_2 != 1) {
+        print_str("FAIL: wake remaining waiter did not return 1\n");
+        sc(93, 20, 0, 0, 0, 0, 0);
+    }
+
+    // Reap both
+    if (r_c1 == 0) sc(260, c1, (long)&st1, 0, 0, 0, 0);
+    if (r_c2 == 0) sc(260, c2, (long)&st2, 0, 0, 0, 0);
+    print_str("PASS: Case 6b (wake second waiter -> 1, both reaped)\n");
+
+    // 7. Real Waiter PRIVATE isolation test on shared mapping
+    volatile uint32_t *p_iso = (void *)sc(222, 0, 16384, 3, 0x21, -1, 0);
+    *p_iso = 0;
+    long c_iso = sc(220, 17, 0, 0, 0, 0, 0);
+    if (c_iso == 0) {
+        // Child waits with SHARED FUTEX_WAIT
+        struct ts t = {2, 0};
+        long wr = sc(98, (long)p_iso, FUTEX_WAIT, 0, (long)&t, 0, 0);
+        sc(93, wr == 0 ? 77 : 99, 0, 0, 0, 0, 0);
+    }
+
+    // Let child park
+    sc(101, (long)&park_d, 0, 0, 0, 0, 0);
+
+    // Parent calls FUTEX_WAKE_PRIVATE on shared mapping -> MUST return 0 (does NOT wake cross-process child)
+    long w_priv = sc(98, (long)p_iso, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
+    if (w_priv != 0) {
+        print_str("FAIL: FUTEX_WAKE_PRIVATE woke external waiter\n");
+        sc(93, 21, 0, 0, 0, 0, 0);
+    }
+    // Verify child is STILL BLOCKED
+    sc(101, (long)&settle_d, 0, 0, 0, 0, 0);
+    int iso_st = 0;
+    long iso_r = sc(260, c_iso, (long)&iso_st, WNOHANG, 0, 0, 0);
+    if (iso_r != 0) {
+        print_str("FAIL: child exited prematurely on PRIVATE wake\n");
+        sc(93, 22, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 7a (FUTEX_WAKE_PRIVATE returns 0, child still blocked)\n");
+
+    // Now parent calls shared FUTEX_WAKE -> child MUST wake and exit with 77
+    long w_shared = sc(98, (long)p_iso, FUTEX_WAKE, 1, 0, 0, 0);
+    if (w_shared != 1) {
+        print_str("FAIL: shared FUTEX_WAKE did not return 1\n");
+        sc(93, 23, 0, 0, 0, 0, 0);
+    }
+    sc(260, c_iso, (long)&iso_st, 0, 0, 0, 0);
+    if ((iso_st >> 8) != 77) {
+        print_str("FAIL: child did not exit with expected code 77\n");
+        sc(93, 24, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 7b (shared FUTEX_WAKE wakes child, reaped 77)\n");
+
+    // 8. Error mapping edge cases
+    // 8a: Misaligned address -> EINVAL (-22)
+    long err1 = sc(98, (long)p + 1, FUTEX_WAIT, 0, 0, 0, 0);
+    if (err1 != -22) {
+        print_str("FAIL: misaligned address did not return -EINVAL\n");
+        sc(93, 25, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8a (misaligned -> -EINVAL)\n");
+
+    // 8b: Zero bitset -> EINVAL (-22)
+    long err2 = sc(98, (long)p, FUTEX_WAIT_BITSET, 0, 0, 0, 0); // bitset = 0
+    if (err2 != -22) {
+        print_str("FAIL: zero bitset did not return -EINVAL\n");
+        sc(93, 26, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8b (zero bitset -> -EINVAL)\n");
+
+    // 8c: Unsupported non-any bitset on shared futex -> ENOSYS (-38)
+    long err3 = sc(98, (long)p, FUTEX_WAIT_BITSET, 0, 0, 0, 1); // bitset = 1
+    if (err3 != -38) {
