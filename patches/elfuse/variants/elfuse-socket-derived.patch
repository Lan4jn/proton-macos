+DERIVED_ELFUSE="$REPO_ROOT/sources/elfuse-derived/build/elfuse"
+ORIG_ELFUSE="$REPO_ROOT/sources/elfuse/build/elfuse"
+SYSROOT="$REPO_ROOT/fixtures/runtime/sysroot"
+LOG="$REPO_ROOT/logs/abi-fix/verification_round3.log"
+
+mkdir -p "$(dirname "$LOG")"
+
+echo "=== ELFUSE ABI FIX VERIFICATION ROUND 3 ===" | tee "$LOG"
+date -u +"Date: %Y-%m-%d %H:%M:%S UTC" | tee -a "$LOG"
+echo "Derived binary: $DERIVED_ELFUSE" | tee -a "$LOG"
+
+# 1. Verify Red State on original binary
+echo "--- 1. Original Binary Red Reproduction ---" | tee -a "$LOG"
+"$ORIG_ELFUSE" --timeout 5 "$REPO_ROOT/fixtures/abi/bin/futex" > /tmp/orig_futex.out 2>&1 || true
+head -n 5 /tmp/orig_futex.out | tee -a "$LOG"
+if grep -q "FUTEX_TIMEOUT_DESPITE_SHARED_WRITE" /tmp/orig_futex.out; then
+    echo "Confirmed: Original binary fails with FUTEX_TIMEOUT_DESPITE_SHARED_WRITE" | tee -a "$LOG"
+fi
+rm -f /tmp/orig_futex.out
+
+# 2. Verify Green State on derived binary
+echo "--- 2. Derived Binary Green Verification (fixtures/abi/bin/futex) ---" | tee -a "$LOG"
+"$DERIVED_ELFUSE" --timeout 5 "$REPO_ROOT/fixtures/abi/bin/futex" 2>&1 | tee -a "$LOG"
+rc=$?
+echo "Exit Code: $rc" | tee -a "$LOG"
+
+# 3. Comprehensive Futex ABI Suite (12 edge cases & rigorous error mapping)
+echo "--- 3. Comprehensive Futex ABI Suite (test_futex_abi_suite) ---" | tee -a "$LOG"
+"$DERIVED_ELFUSE" --timeout 5 "$REPO_ROOT/sources/elfuse-derived/tests/test_futex_abi_suite" 2>&1 | tee -a "$LOG"
+rc=$?
+echo "Exit Code: $rc" | tee -a "$LOG"
+
+# 4. Shared memory fixture
+echo "--- 4. Shared memory fixture (fixtures/abi/bin/shared) ---" | tee -a "$LOG"
+"$DERIVED_ELFUSE" --timeout 5 "$REPO_ROOT/fixtures/abi/bin/shared" 2>&1 | tee -a "$LOG"
+echo "Exit Code: $?" | tee -a "$LOG"
+
+# 5. Signal fixture
