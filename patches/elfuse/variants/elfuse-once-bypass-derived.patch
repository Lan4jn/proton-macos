+            (unsigned long long)once_trace_target_uaddr, cur_val, cur_val, once_trace_last_val,
+            is_mapped ? 1 : 0,
+            is_mapped ? (unsigned long long)r->start : 0ULL,
+            is_mapped ? (unsigned long long)r->end : 0ULL,
+            is_mapped ? ((r->prot & 2) ? "rw-" : "r--") : "---",
+            reason,
+            (unsigned long long)cur_elr, (unsigned long long)cur_lr,
