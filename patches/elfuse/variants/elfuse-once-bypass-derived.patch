+/* Fixture-only observer: each thread scans at most 64 KiB per process image. */
+static void fixture_identity_observe(int gfd, int hfd, const struct iovec *iov, int nvec)
+{
+    if (!getenv("ELFUSE_FIXTURE_IDENTITY")) return;
+    static _Thread_local size_t progress, scanned;
+    static _Thread_local dev_t stream_dev;
+    static _Thread_local ino_t stream_ino;
+    static unsigned emitted;
+    static const char marker[] = "[WIN_ARM64_VK] Step 3: Calling vkCreateInstance(API=1.0)...";
+    int saved_errno = errno;
+    struct stat out, actual;
+    if (fstat(STDOUT_FILENO, &out) < 0 || fstat(hfd, &actual) < 0 ||
+        out.st_dev != actual.st_dev || out.st_ino != actual.st_ino ||
+        (out.st_mode & S_IFMT) != (actual.st_mode & S_IFMT)) {
+        progress = 0;
+        errno = saved_errno;
+        return;
+    }
+    if (stream_dev != actual.st_dev || stream_ino != actual.st_ino) {
+        progress = 0;
+        stream_dev = actual.st_dev;
+        stream_ino = actual.st_ino;
+    }
+    for (int j = 0; j < nvec && scanned < 65536; j++) {
+        const unsigned char *bytes = iov[j].iov_base;
+        size_t len = iov[j].iov_len;
+        if (len > 65536 - scanned) len = 65536 - scanned;
+        for (size_t i = 0; i < len; i++) {
+            scanned++;
+            if (bytes[i] == (unsigned char)marker[progress]) progress++;
+            else progress = bytes[i] == (unsigned char)marker[0] ? 1 : 0;
+            if (progress == sizeof(marker)-1) {
+                fixture_step3_seen = true;
+                progress = 0;
+                if (__atomic_fetch_add(&emitted, 1, __ATOMIC_RELAXED) == 0) {
+                    char line[224];
+                    int n = snprintf(line, sizeof(line),
+                        "FIXTURE_STEP3_IDENTITY pid=%ld ppid=%ld gtid=%lld gfd=%d nvec=%d phase=write_request%c",
+                        (long)getpid(), (long)getppid(),
+                        current_thread ? (long long)current_thread->guest_tid : -1LL, gfd, nvec, 10);
+                    if (n > 0 && (size_t)n < sizeof(line)) (void)write(STDERR_FILENO, line, (size_t)n);
+                }
+            }
+        }
+    }
+    errno = saved_errno;
+}
