+/* =========================================================================
+ * ELR Category Classification & Re-entry Timeline (Task-79)
+ * ========================================================================= */
+typedef enum {
+    CAT_UNKNOWN = 0,
+    CAT_LIBC_ONCE_SLOW,    /* 0x2000ce000 .. 0x2000ce120 (libc once slow path) */
+    CAT_LIBC_OTHER,        /* other code in libc.so.6 */
+    CAT_LOADER_RX,         /* 0x10000000 .. 0x10200000 (0x1004xxxx / 0x1002xxxx) */
+    CAT_LAVAPIPE,          /* libvulkan_lvp.so / libLLVM */
+    CAT_WINE,              /* ntdll.so, win32u.so, winevulkan.so, wine */
+    CAT_OTHER              /* any other guest code */
+} elr_category_t;
+
+static const char *elr_category_name(elr_category_t cat) {
+    switch (cat) {
+    case CAT_LIBC_ONCE_SLOW: return "libc_once_slow";
+    case CAT_LIBC_OTHER: return "libc_other";
+    case CAT_LOADER_RX: return "loader_rx";
+    case CAT_LAVAPIPE: return "lavapipe";
+    case CAT_WINE: return "wine";
+    case CAT_OTHER: return "other";
+    default: return "unknown";
+    }
+}
+
+static elr_category_t classify_elr(const guest_t *g, uint64_t elr, char *mod_out, size_t mod_sz, uint64_t *off_out) {
+    if (mod_out && mod_sz > 0) mod_out[0] = '\0';
+    if (off_out) *off_out = 0;
+    if (!g || elr == 0) return CAT_UNKNOWN;
+
+    if (elr >= 0x10000000ULL && elr < 0x10200000ULL) {
+        if (mod_out) snprintf(mod_out, mod_sz, "loader_rx");
+        if (off_out) *off_out = elr - 0x10000000ULL;
+        return CAT_LOADER_RX;
+    }
+
+    const guest_region_t *r = guest_region_find(g, elr);
+    if (!r) {
+        if (mod_out) snprintf(mod_out, mod_sz, "[unmapped]");
+        return CAT_OTHER;
+    }
+
+    char mod[MAXPATHLEN];
+    mod[0] = '\0';
+    if (r->backing_fd >= 0 && fcntl(r->backing_fd, F_GETPATH, mod) == 0) {
+        /* host path */
+    } else if (r->name[0] != '\0') {
+        snprintf(mod, sizeof(mod), "%s", r->name);
+    } else {
+        snprintf(mod, sizeof(mod), "[anon]");
+    }
+
+    if (mod_out) snprintf(mod_out, mod_sz, "%s", mod);
+    if (off_out) *off_out = (r->backing_fd >= 0) ? (r->offset + (elr - r->start)) : (elr - r->start);
+
+    if (strstr(mod, "libc.so") != NULL) {
+        if (elr >= 0x2000ce000ULL && elr <= 0x2000ce120ULL) {
+            return CAT_LIBC_ONCE_SLOW;
+        }
+        if (off_out && *off_out >= 0x8e000 && *off_out <= 0x8e120) {
+            return CAT_LIBC_ONCE_SLOW;
+        }
+        return CAT_LIBC_OTHER;
+    }
+    if (strstr(mod, "vulkan_lvp") != NULL || strstr(mod, "LLVM") != NULL) {
+        return CAT_LAVAPIPE;
+    }
+    if (strstr(mod, "wine") != NULL || strstr(mod, "ntdll") != NULL || strstr(mod, "win32u") != NULL) {
+        return CAT_WINE;
+    }
+    return CAT_OTHER;
+}
+
+static _Atomic elr_category_t last_sampled_cat = CAT_UNKNOWN;
+
+static void update_and_log_category(const guest_t *g, uint64_t cur_elr, const char *trigger) {
+    if (!g || cur_elr == 0) return;
+    if (!atomic_load_explicit(&once_trace_sampler_armed, memory_order_relaxed)) return;
+    char mod[MAXPATHLEN];
+    uint64_t off = 0;
+    elr_category_t cur_cat = classify_elr(g, cur_elr, mod, sizeof(mod), &off);
+    elr_category_t prev_cat = atomic_load_explicit(&last_sampled_cat, memory_order_relaxed);
+
+    if (cur_cat != prev_cat) {
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        uint64_t us = (uint64_t)ts.tv_sec * 1000000ULL + ts.tv_nsec / 1000;
+        char line[512];
+        int n = snprintf(line, sizeof(line),
+            "REENTRY_TIMELINE ts_us=%llu pid=%ld gtid=1 elr=0x%llx cat=%s prev_cat=%s mod=%s off=0x%llx trigger=%s%c",
+            (unsigned long long)us, (long)getpid(), (unsigned long long)cur_elr,
+            elr_category_name(cur_cat), elr_category_name(prev_cat),
+            mod, (unsigned long long)off, trigger, 10);
+        if (n > 0 && (size_t)n < sizeof(line)) (void)write(STDERR_FILENO, line, (size_t)n);
+        atomic_store_explicit(&last_sampled_cat, cur_cat, memory_order_relaxed);
+    }
+}
