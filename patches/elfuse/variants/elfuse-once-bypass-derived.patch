+        long wr = sc(98, (long)p_iso, FUTEX_WAIT, 0, (long)&t, 0, 0);
+        sc(93, wr == 0 ? 77 : 99, 0, 0, 0, 0, 0);
+    }
+
+    // Let child park
+    sc(101, (long)&park_d, 0, 0, 0, 0, 0);
+
+    // Parent calls FUTEX_WAKE_PRIVATE on shared mapping -> MUST return 0 (does NOT wake cross-process child)
+    long w_priv = sc(98, (long)p_iso, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
+    if (w_priv != 0) {
+        print_str("FAIL: FUTEX_WAKE_PRIVATE woke external waiter\n");
+        sc(93, 21, 0, 0, 0, 0, 0);
+    }
+    // Verify child is STILL BLOCKED
