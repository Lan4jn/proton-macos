+    int iso_st = 0;
+    long iso_r = sc(260, c_iso, (long)&iso_st, WNOHANG, 0, 0, 0);
+    if (iso_r != 0) {
+        print_str("FAIL: child exited prematurely on PRIVATE wake\n");
+        sc(93, 22, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 7a (FUTEX_WAKE_PRIVATE returns 0, child still blocked)\n");
+
+    // Now parent calls shared FUTEX_WAKE -> child MUST wake and exit with 77
+    long w_shared = sc(98, (long)p_iso, FUTEX_WAKE, 1, 0, 0, 0);
+    if (w_shared != 1) {
+        print_str("FAIL: shared FUTEX_WAKE did not return 1\n");
+        sc(93, 23, 0, 0, 0, 0, 0);
+    }
+    sc(260, c_iso, (long)&iso_st, 0, 0, 0, 0);
+    if ((iso_st >> 8) != 77) {
+        print_str("FAIL: child did not exit with expected code 77\n");
+        sc(93, 24, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 7b (shared FUTEX_WAKE wakes child, reaped 77)\n");
+
+    // 8. Error mapping edge cases
+    // 8a: Misaligned address -> EINVAL (-22)
+    long err1 = sc(98, (long)p + 1, FUTEX_WAIT, 0, 0, 0, 0);
+    if (err1 != -22) {
+        print_str("FAIL: misaligned address did not return -EINVAL\n");
+        sc(93, 25, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8a (misaligned -> -EINVAL)\n");
+
+    // 8b: Zero bitset -> EINVAL (-22)
+    long err2 = sc(98, (long)p, FUTEX_WAIT_BITSET, 0, 0, 0, 0); // bitset = 0
+    if (err2 != -22) {
+        print_str("FAIL: zero bitset did not return -EINVAL\n");
+        sc(93, 26, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8b (zero bitset -> -EINVAL)\n");
+
+    // 8c: Unsupported non-any bitset on shared futex -> ENOSYS (-38)
+    long err3 = sc(98, (long)p, FUTEX_WAIT_BITSET, 0, 0, 0, 1); // bitset = 1
+    if (err3 != -38) {
+        print_str("FAIL: partial bitset on shared did not return -ENOSYS\n");
+        sc(93, 27, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8c (partial bitset on shared -> -ENOSYS)\n");
+
+    // 8d: Unmapped invalid pointer -> EFAULT (-14)
+    long err4 = sc(98, 0x1234, FUTEX_WAIT, 0, 0, 0, 0);
+    if (err4 != -14) {
+        print_str("FAIL: unmapped pointer did not return -EFAULT\n");
+        sc(93, 28, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8d (unmapped -> -EFAULT)\n");
+
+    // 8e: Wake error mappings
+    long err5 = sc(98, (long)p + 1, FUTEX_WAKE, 1, 0, 0, 0);
+    if (err5 != -22) {
+        print_str("FAIL: misaligned wake did not return -EINVAL\n");
+        sc(93, 29, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8e (misaligned wake -> -EINVAL)\n");
+
+    // 8f: Wake on address with zero waiters returns 0 (Linux standard behavior)
+    long err6 = sc(98, 0x1234, FUTEX_WAKE, 1, 0, 0, 0);
+    if (err6 != 0) {
+        print_str("FAIL: unmapped wake with 0 waiters did not return 0\n");
+        sc(93, 30, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8f (wake 0 waiters on unmapped addr -> 0)\n");
+
+    // 9. sys_futex_waitv on shared mapping -> ENOSYS (-38)
+    struct {
+        uint64_t val;
+        uint64_t uaddr;
+        uint32_t flags;
+        uint32_t __reserved;
+    } wv = { 0, (uint64_t)p, 2 /* FUTEX2_SIZE_U32, shared */, 0 };
+    long waitv_res = sc(449, (long)&wv, 1, 0, 0, 0, 0);
+    if (waitv_res != -38) {
+        print_str("FAIL: shared waitv did not return -ENOSYS\n");
+        sc(93, 31, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 9 (shared waitv -> -ENOSYS)\n");
+
+    // 10. sys_futex_waitv with FUTEX2_PRIVATE on stack/private memory -> non-ENOSYS (mismatch returns -EAGAIN)
+    uint32_t priv_word = 123;
+    struct {
+        uint64_t val;
+        uint64_t uaddr;
+        uint32_t flags;
+        uint32_t __reserved;
+    } wv_priv = { 999 /* mismatch */, (uint64_t)&priv_word, 2 | 0x80 /* FUTEX2_SIZE_U32 | FUTEX2_PRIVATE */, 0 };
+    long waitv_priv_res = sc(449, (long)&wv_priv, 1, 0, 0, 0, 0);
+    if (waitv_priv_res != -11) {
+        print_str("FAIL: private waitv mismatch did not return -EAGAIN\n");
+        sc(93, 32, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 10 (private waitv supported, mismatch -> -EAGAIN)\n");
+
+    print_str("ALL FUTEX ABI SUITE TESTS PASSED!\n");
+    sc(93, 0, 0, 0, 0, 0, 0);
+}
