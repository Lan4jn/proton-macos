+    /* Safe load under HOST_SIGBUS_GUARD */
+    uint32_t cur;
+    if (!futex_word_load(word, &cur))
+        return -LINUX_EFAULT;
+
+    /* Linux futex: if the current word does not match expected, return EAGAIN */
+    if (cur != expected)
+        return -LINUX_EAGAIN;
+
+    /* If timeout already expired, return ETIMEDOUT immediately */
+    if (has_timeout && futex_remaining_ns(&deadline, UINT64_MAX, NULL) == 0)
+        return -LINUX_ETIMEDOUT;
+
+    int ret = 0;
+    for (;;) {
+        if (!futex_word_load(word, &cur))
+            return -LINUX_EFAULT;
+        if (cur != expected) {
+            ret = 0;
+            break;
+        }
+
+        if (thread_stop_requested() || futex_interrupt_consume()) {
+            ret = -LINUX_EINTR;
+            break;
+        }
+
+        signal_check_timer_real();
+        if (signal_claim_interruption() || futex_kick_consume()) {
+            ret = -LINUX_EINTR;
+            break;
+        }
