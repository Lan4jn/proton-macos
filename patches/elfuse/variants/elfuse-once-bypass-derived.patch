+            if (errno == ETIMEDOUT) {
+                if (has_timeout && futex_remaining_ns(&deadline, UINT64_MAX, NULL) == 0) {
+                    ret = -LINUX_ETIMEDOUT;
+                    break;
+                }
+                continue;
+            }
+            if (errno == EINTR) {
+                ret = -LINUX_EINTR;
+                break;
+            }
+            ret = linux_errno();
+            break;
+        }
+    }
