+        uint64_t slice_ns = 50000000ULL; /* 50ms slice */
+        if (has_timeout) {
+            uint64_t rem = futex_remaining_ns(&deadline, UINT64_MAX, NULL);
+            if (rem == 0) {
+                ret = -LINUX_ETIMEDOUT;
+                break;
+            }
+            if (slice_ns > rem)
+                slice_ns = rem;
+        }
