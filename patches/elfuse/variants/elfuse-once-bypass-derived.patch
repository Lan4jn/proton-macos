+        (unsigned long long)us, (long)getpid(), trigger,
+        thread_active_count(), 10);
+    if (hn > 0 && (size_t)hn < sizeof(hdr)) (void)write(STDERR_FILENO, hdr, (size_t)hn);
+
+    struct futex_owner_dump_ctx ctx = { getpid(), current_thread ? current_thread->guest_tid : -1LL, 0 };
+    thread_for_each(futex_owner_thread_cb, &ctx);
+
+    char ftr[128];
+    int fn = snprintf(ftr, sizeof(ftr), "THREAD_SNAPSHOT_END ts_us=%llu pid=%ld%c", (unsigned long long)us, (long)getpid(), 10);
+    if (fn > 0 && (size_t)fn < sizeof(ftr)) (void)write(STDERR_FILENO, ftr, (size_t)fn);
