+static void check_and_log_once_transition(const guest_t *g, const char *trigger, uint64_t cur_elr, uint64_t cur_lr)
+{
+    if (!g) return;
+    pthread_mutex_lock(&once_trace_lock);
+    once_trace_sample_count++;
+
+    const guest_region_t *r = guest_region_find(g, once_trace_target_uaddr);
+    bool is_mapped = (r != NULL);
+    uint32_t cur_val = 0;
+    if (is_mapped) {
+        (void)guest_read_small(g, once_trace_target_uaddr, &cur_val, sizeof(cur_val));
+    }
+
+    bool cond_a = (!once_trace_was_mapped && is_mapped);
+    bool cond_b = (once_trace_was_mapped && is_mapped && (cur_val != once_trace_last_val));
+    bool cond_c = once_trace_first_read;
+
+    if (cond_a || cond_b || cond_c) {
+        if (cur_elr == 0 && cur_lr == 0) {
+            cur_elr = atomic_load_explicit(&last_main_elr, memory_order_relaxed);
+            cur_lr = atomic_load_explicit(&last_main_lr, memory_order_relaxed);
+        }
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        uint64_t us = (uint64_t)ts.tv_sec * 1000000ULL + ts.tv_nsec / 1000;
+
+        const char *reason = cond_b ? "val_change" : (cond_a ? "first_mapped" : "first_read");
+
+        char line[512];
+        int n = snprintf(line, sizeof(line),
+            "ONCE_TRANSITION ts_us=%llu pid=%ld gtid=%lld uaddr=0x%llx val=0x%x (dec:%u) prev_val=0x%x mapped=%d range=[0x%llx,0x%llx) prot=%s reason=%s elr=0x%llx lr=0x%llx trigger=%s%c",
