+    if (err5 != -22) {
+        print_str("FAIL: misaligned wake did not return -EINVAL\n");
+        sc(93, 29, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8e (misaligned wake -> -EINVAL)\n");
+
+    // 8f: Wake on address with zero waiters returns 0 (Linux standard behavior)
+    long err6 = sc(98, 0x1234, FUTEX_WAKE, 1, 0, 0, 0);
+    if (err6 != 0) {
+        print_str("FAIL: unmapped wake with 0 waiters did not return 0\n");
+        sc(93, 30, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8f (wake 0 waiters on unmapped addr -> 0)\n");
+
+    // 9. sys_futex_waitv on shared mapping -> ENOSYS (-38)
+    struct {
+        uint64_t val;
+        uint64_t uaddr;
+        uint32_t flags;
+        uint32_t __reserved;
+    } wv = { 0, (uint64_t)p, 2 /* FUTEX2_SIZE_U32, shared */, 0 };
+    long waitv_res = sc(449, (long)&wv, 1, 0, 0, 0, 0);
+    if (waitv_res != -38) {
