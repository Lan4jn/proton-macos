+        sc(93, 25, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8a (misaligned -> -EINVAL)\n");
+
+    // 8b: Zero bitset -> EINVAL (-22)
+    long err2 = sc(98, (long)p, FUTEX_WAIT_BITSET, 0, 0, 0, 0); // bitset = 0
+    if (err2 != -22) {
+        print_str("FAIL: zero bitset did not return -EINVAL\n");
+        sc(93, 26, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 8b (zero bitset -> -EINVAL)\n");
+
+    // 8c: Unsupported non-any bitset on shared futex -> ENOSYS (-38)
