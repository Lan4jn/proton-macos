+        sc(93, 31, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 9 (shared waitv -> -ENOSYS)\n");
+
+    // 10. sys_futex_waitv with FUTEX2_PRIVATE on stack/private memory -> non-ENOSYS (mismatch returns -EAGAIN)
+    uint32_t priv_word = 123;
+    struct {
+        uint64_t val;
+        uint64_t uaddr;
+        uint32_t flags;
+        uint32_t __reserved;
+    } wv_priv = { 999 /* mismatch */, (uint64_t)&priv_word, 2 | 0x80 /* FUTEX2_SIZE_U32 | FUTEX2_PRIVATE */, 0 };
+    long waitv_priv_res = sc(449, (long)&wv_priv, 1, 0, 0, 0, 0);
+    if (waitv_priv_res != -11) {
+        print_str("FAIL: private waitv mismatch did not return -EAGAIN\n");
+        sc(93, 32, 0, 0, 0, 0, 0);
+    }
+    print_str("PASS: Case 10 (private waitv supported, mismatch -> -EAGAIN)\n");
+
+    print_str("ALL FUTEX ABI SUITE TESTS PASSED!\n");
+    sc(93, 0, 0, 0, 0, 0, 0);
