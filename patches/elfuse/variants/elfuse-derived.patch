+static int64_t futex_wait_shared(guest_t *g,
+                                 uint64_t uaddr,
+                                 uint32_t expected,
+                                 uint64_t timeout_gva,
+                                 uint32_t bitset,
+                                 int is_absolute)
+{
+    if (bitset == 0)
+        return -LINUX_EINVAL;
+    if (bitset != FUTEX_BITSET_MATCH_ANY)
+        return -LINUX_ENOSYS;
+    if (!futex_uaddr_is_aligned(uaddr))
+        return -LINUX_EINVAL;
+
+    bool has_timeout = (timeout_gva != 0);
+    struct timespec deadline;
+    if (has_timeout) {
+        int rc = futex_make_deadline(g, timeout_gva, is_absolute, &deadline);
+        if (rc == -1)
+            return -LINUX_EFAULT;
+        if (rc == -2)
+            return -LINUX_EINVAL;
+    }
+
+    uint32_t *word = (uint32_t *) guest_ptr(g, uaddr);
+    if (!word)
+        return -LINUX_EFAULT;
+
+    /* Safe load under HOST_SIGBUS_GUARD */
+    uint32_t cur;
+    if (!futex_word_load(word, &cur))
+        return -LINUX_EFAULT;
+
+    /* Linux futex: if the current word does not match expected, return EAGAIN */
+    if (cur != expected)
+        return -LINUX_EAGAIN;
+
+    /* If timeout already expired, return ETIMEDOUT immediately */
+    if (has_timeout && futex_remaining_ns(&deadline, UINT64_MAX, NULL) == 0)
+        return -LINUX_ETIMEDOUT;
+
+    int ret = 0;
+    for (;;) {
+        if (!futex_word_load(word, &cur))
+            return -LINUX_EFAULT;
+        if (cur != expected) {
+            ret = 0;
+            break;
+        }
+
+        if (thread_stop_requested() || futex_interrupt_consume()) {
+            ret = -LINUX_EINTR;
+            break;
+        }
+
+        signal_check_timer_real();
+        if (signal_claim_interruption() || futex_kick_consume()) {
+            ret = -LINUX_EINTR;
+            break;
+        }
+
+        uint64_t slice_ns = 50000000ULL; /* 50ms slice */
+        if (has_timeout) {
+            uint64_t rem = futex_remaining_ns(&deadline, UINT64_MAX, NULL);
+            if (rem == 0) {
+                ret = -LINUX_ETIMEDOUT;
+                break;
+            }
+            if (slice_ns > rem)
+                slice_ns = rem;
+        }
+
+        int os_rc = os_sync_wait_on_address_with_timeout(
+            word, expected, 4,
+            OS_SYNC_WAIT_ON_ADDRESS_SHARED,
+            OS_CLOCK_MACH_ABSOLUTE_TIME,
+            slice_ns
+        );
+
+        if (os_rc >= 0) {
+            /* Successfully woken by waker (returns remaining waiter count >= 0) */
+            ret = 0;
+            break;
+        }
+
+        if (os_rc < 0) {
+            if (errno == ETIMEDOUT) {
+                if (has_timeout && futex_remaining_ns(&deadline, UINT64_MAX, NULL) == 0) {
+                    ret = -LINUX_ETIMEDOUT;
+                    break;
+                }
+                continue;
+            }
+            if (errno == EINTR) {
+                ret = -LINUX_EINTR;
+                break;
+            }
+            ret = linux_errno();
+            break;
+        }
+    }
+
+    return ret;
+}
+
+/* Cross-process futex wake on MAP_SHARED memory when !(op & FUTEX_PRIVATE_FLAG) */
+static int64_t futex_wake_shared(const guest_t *g,
+                                 uint64_t uaddr,
+                                 uint32_t val,
+                                 uint32_t bitset)
+{
+    if (bitset == 0)
+        return -LINUX_EINVAL;
+    if (bitset != FUTEX_BITSET_MATCH_ANY)
+        return -LINUX_ENOSYS;
+    if (!futex_uaddr_is_aligned(uaddr))
+        return -LINUX_EINVAL;
+
+    if (val == 0)
+        return 0;
+
+    uint32_t *word = (uint32_t *) guest_ptr(g, uaddr);
+    if (!word)
+        return -LINUX_EFAULT;
+
+    /* Verify word is readable under SIGBUS guard */
+    uint32_t probe;
+    if (!futex_word_load(word, &probe))
+        return -LINUX_EFAULT;
+
+    /* Wake waiters one by one up to val, stopping on ENOENT */
+    uint32_t woken = 0;
+    while (woken < val) {
+        int rc = os_sync_wake_by_address_any(word, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED);
+        if (rc == 0) {
+            woken++;
+        } else if (errno == ENOENT) {
+            /* No more waiters */
+            break;
+        } else {
+            return linux_errno();
+        }
+    }
+
+    return (int64_t) woken;
+}
