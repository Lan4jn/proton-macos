+/* Cross-process futex wake on MAP_SHARED memory when !(op & FUTEX_PRIVATE_FLAG) */
+static int64_t futex_wake_shared(const guest_t *g,
+                                 uint64_t uaddr,
+                                 uint32_t val,
+                                 uint32_t bitset)
+{
+    if (bitset == 0)
+        return -LINUX_EINVAL;
+    if (bitset != FUTEX_BITSET_MATCH_ANY)
+        return -LINUX_ENOSYS;
+    if (!futex_uaddr_is_aligned(uaddr))
+        return -LINUX_EINVAL;
+
+    if (val == 0)
+        return 0;
+
+    uint32_t *word = (uint32_t *) guest_ptr(g, uaddr);
+    if (!word)
+        return -LINUX_EFAULT;
+
+    /* Verify word is readable under SIGBUS guard */
+    uint32_t probe;
+    if (!futex_word_load(word, &probe))
+        return -LINUX_EFAULT;
+
+    /* Wake waiters one by one up to val, stopping on ENOENT */
+    uint32_t woken = 0;
+    while (woken < val) {
+        int rc = os_sync_wake_by_address_any(word, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED);
+        if (rc == 0) {
+            woken++;
+        } else if (errno == ENOENT) {
+            /* No more waiters */
+            break;
+        } else {
+            return linux_errno();
+        }
+    }
+
+    return (int64_t) woken;
+}
